DROP TABLE IF EXISTS dbo.RestartEventMap;
CREATE TABLE dbo.RestartEventMap (
    MapId          INT IDENTITY(1,1) PRIMARY KEY,
    LogName        NVARCHAR(200) NOT NULL,
    EventId        INT           NOT NULL,
    MessagePattern NVARCHAR(200) NULL,       -- LIKE pattern, NULL = any message
    Category       NVARCHAR(20)  NOT NULL,
    IsTrigger      BIT           NOT NULL
);

