CREATE TABLE dbo.RestartIncident (
    IncidentId           INT IDENTITY(1,1) PRIMARY KEY,
    ServerName           NVARCHAR(128) NOT NULL,
    TriggerTime          DATETIME      NOT NULL,
    TriggerCategory      NVARCHAR(20)  NOT NULL,
    TriggerEventId       INT           NOT NULL,
    TriggerMessage       NVARCHAR(MAX) NULL,
    DetectedAt           DATETIME      NOT NULL DEFAULT GETDATE(),
    Status               NVARCHAR(20)  NOT NULL DEFAULT 'Open',   -- Open, Healthy, GaveUp
    NotBackEmailSent     BIT           NOT NULL DEFAULT 0,
    ServiceFailEmailSent BIT           NOT NULL DEFAULT 0,
    LastCheckTime        DATETIME      NULL,
    LastError            NVARCHAR(MAX) NULL,
    ClosedAt             DATETIME      NULL
);
CREATE INDEX IX_RestartIncident_Server ON dbo.RestartIncident (ServerName, Status, TriggerTime);


